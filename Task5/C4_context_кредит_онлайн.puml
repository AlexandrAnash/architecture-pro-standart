@startuml
title Диаграмма контекста. Подача заявки на кредит онлайн. Банк «Стандарт»

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_TOP_DOWN()

Person(client, "Клиент", "Новый или действующий клиент банка")
Person(manager, "Менеджер отделения", "Оформляет заявку при визите клиента")
Person(creditOfficer, "Сотрудник управления кредитования", "Принимает решение по заявке в Кредитном конвейере")

System(creditPlatform, "Кредитная платформа", "НОВАЯ. Единый реестр кредитных заявок из всех каналов и предодобренные предложения")

System(site, "Сайт", "Витрина кредитов и форма заявки для нового клиента")
System(ib, "Интернет-банк", "Личный кабинет действующего клиента")
System(pipeline, "Кредитный конвейер", "Обработка заявок, условия кредитов, решение по заявке")
System(scoring, "Система кредитного скоринга", "Рейтинг клиента и допустимая сумма кредита")
System(abs, "АБС", "Учёт счетов, зачисление кредитных средств")
System(smsGw, "СМС-шлюз", "Отправка СМС")

System_Ext(bki, "Бюро кредитных историй", "Внешняя система, REST API")
System_Ext(telecom, "Телеком-оператор", "Внешний оператор доставки СМС")

Rel(client, site, "Смотрит условия кредита, подаёт заявку, получает предварительное решение", "HTTPS")
Rel(client, ib, "Видит предодобренное предложение, подаёт заявку, подтверждает СМС-кодом", "HTTPS")
Rel(client, manager, "Приходит в отделение для идентификации и получения кредита", "Визит")

Rel(site, creditPlatform, "Запрашивает условия, передаёт заявку", "REST/HTTPS")
Rel(ib, creditPlatform, "Запрашивает предодобренное предложение, передаёт заявку", "REST/HTTPS")

Rel(creditPlatform, pipeline, "Передаёт заявку и получает статусы онлайн, минуя суточный обмен", "REST/HTTPS")
Rel(creditPlatform, scoring, "Запрашивает скоринг по конкретной заявке", "REST/HTTPS")
Rel(creditPlatform, abs, "Получает данные клиента, инициирует зачисление одобренных средств", "REST/HTTPS")

Rel(manager, abs, "Оформляет заявку при визите клиента", "Десктоп-клиент")
Rel(abs, creditPlatform, "Ищет ранее поданную заявку клиента, чтобы продолжить работу с ней", "REST/HTTPS")

Rel(creditOfficer, pipeline, "Изучает заявку и принимает решение", "Веб-интерфейс")
Rel(scoring, bki, "Запрашивает кредитную историю", "REST/HTTPS, онлайн")
Rel(pipeline, scoring, "Вызывает скоринг при обработке заявки", "REST/HTTPS")

Rel(creditPlatform, smsGw, "Отправляет коды подтверждения и уведомления о статусе заявки", "REST/HTTPS")
Rel(smsGw, telecom, "Передаёт СМС", "Протокол оператора")
Rel(telecom, client, "Доставляет СМС", "СМС")

@enduml
