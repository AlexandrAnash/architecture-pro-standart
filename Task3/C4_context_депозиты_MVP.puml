@startuml
title Диаграмма контекста. Открытие депозитов онлайн, MVP. Банк «Стандарт»

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_TOP_DOWN()

Person(client, "Клиент", "Действующий или новый клиент банка")
Person(ccOperator, "Оператор кол-центра", "Обрабатывает заявки с сайта и консультирует клиентов")
Person(boDeposit, "Сотрудник бэк-офиса депозитов", "Согласует индивидуальные ставки, обрабатывает заявки")
Person(boCredit, "Сотрудник бэк-офиса кредитов", "Задаёт параметры расчёта ставок")

System(depositPlatform, "Депозитная платформа", "НОВАЯ. Справочник и расчёт ставок, приём и статусы заявок на депозит, уведомления клиенту")

System(site, "Сайт", "Витрина депозитов и форма заявки для новых клиентов")
System(ib, "Интернет-банк", "Личный кабинет действующего клиента")
System(abs, "АБС", "Учёт счетов, депозитов и бухгалтерия")
System(callCenter, "Система кол-центра", "Рабочее место оператора кол-центра")
System(smsGw, "СМС-шлюз", "Отправка СМС, поддерживается IT-отделом банка")

System_Ext(telecom, "Телеком-оператор", "Внешний оператор доставки СМС")

Rel(client, site, "Смотрит ставки, оставляет заявку на депозит", "HTTPS")
Rel(client, ib, "Смотрит ставки и персональную ставку, подаёт заявку, подтверждает СМС-кодом", "HTTPS")

Rel(site, depositPlatform, "Запрашивает актуальные ставки, передаёт заявку", "REST/HTTPS")
Rel(ib, depositPlatform, "Запрашивает ставки и персональную ставку, передаёт заявку", "REST/HTTPS")

Rel(depositPlatform, callCenter, "Передаёт заявку нового клиента с сайта", "REST/HTTPS")
Rel(ccOperator, callCenter, "Изучает заявку, предлагает особые условия", "Веб-интерфейс")

Rel(boCredit, depositPlatform, "Вводит ставку рефинансирования и уровень кредитного риска", "Веб-интерфейс")
Rel(boDeposit, depositPlatform, "Согласует индивидуальную ставку по заявке", "Веб-интерфейс")

Rel(depositPlatform, abs, "Передаёт заявки, получает статусы и подтверждённые условия", "REST/HTTPS, асинхронно")
Rel(boDeposit, abs, "Обрабатывает заявку и подтверждает условия депозита", "Десктоп-клиент")

Rel(depositPlatform, smsGw, "Отправляет коды подтверждения и уведомления", "REST/HTTPS")
Rel(smsGw, telecom, "Передаёт СМС", "Протокол оператора")
Rel(telecom, client, "Доставляет СМС", "СМС")

@enduml
